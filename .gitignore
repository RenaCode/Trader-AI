.env
.env.local
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.next/
dist/
build/
*.log
.DS_Store
data/
artifacts/

# Globalny ~/.gitignore_global uzytkownika wyklucza package-lock.json. Tutaj go
# przywracamy: `npm ci` w obrazie Dockera wymaga lockfile'a, a bez niego build
# nie jest odtwarzalny (kazdy przebieg moglby zaciagnac inne wersje zaleznosci).
!package-lock.json
!web/package-lock.json

# ...oraz caly katalog `scripts` (wzorzec [Ss]cripts). Bez tej negacji `git add`
# po cichu pomija skrypty operacyjne, a obraz Dockera nie ma czego skopiowac.
!scripts/
!scripts/**

# Skrypty diagnostyczne uruchamiane doraznie z katalogu glownego.
/shot.mjs
/diag.mjs
/check.mjs
