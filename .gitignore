.env
.env.local
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.next/
dist/
build/
*.log
.DS_Store
data/
artifacts/

# Globalny ~/.gitignore_global uzytkownika wyklucza package-lock.json. Tutaj go
# przywracamy: `npm ci` w obrazie Dockera wymaga lockfile'a, a bez niego build
# nie jest odtwarzalny (kazdy przebieg moglby zaciagnac inne wersje zaleznosci).
!package-lock.json
!web/package-lock.json

# ...oraz caly katalog `scripts` (wzorzec [Ss]cripts). Bez tej negacji `git add`
# po cichu pomija skrypty operacyjne, a obraz Dockera nie ma czego skopiowac.
!scripts/
!scripts/**

# Skrypty diagnostyczne uruchamiane doraznie z katalogu glownego.
/shot.mjs
/diag.mjs
/check.mjs

# Worktree agentow pracujacych w tle. To osobne repozytoria, nie tresc projektu -
# git add -A wciagnal je raz jako zagnieżdżone repo i zepsul commit.
.claude/worktrees/

# Lokalny stan narzedzi Claude / claude-flow / ruflo.
# To sa artefakty konkretnej maszyny i sesji (liczniki edycji, polityki,
# przyjeta konfiguracja) - nie opisuja projektu i nie naleza do repozytorium.
# Definicje agentow (.claude/agents/) i CLAUDE.md zostaja SLEDZONE celowo.
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version
.claude/settings.local.json
.claude/worktrees/
.claude/sessions/
.claude/todos/
.specstory/
