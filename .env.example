# --- baza / cache -------------------------------------------------------
POSTGRES_PASSWORD=trader_dev
DB_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql://trader:trader_dev@localhost:5433/trader

# --- szyfrowanie sekretow w bazie --------------------------------------
# 32 bajty base64. Klucze API gield i sekrety TOTP sa szyfrowane AES-GCM tym kluczem.
# Generacja: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

# --- dostawca analizy wiadomosci ----------------------------------------
# Ustaw JEDEN z kluczy. Gdy sa oba, wygrywa Anthropic (dostawca docelowy).
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5
TRIAGE_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
ANALYSIS_MODEL_GEMINI=gemini-3.5-flash
TRIAGE_MODEL_GEMINI=gemini-3.5-flash-lite

# Twardy limit wydatkow na dobe, wspolny dla obu dostawcow.
LLM_DAILY_USD=5.0

# --- gieldy (uzupelniane przez UI, nie tutaj -- to tylko fallback dev) ---
