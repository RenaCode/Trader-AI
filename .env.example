# --- baza / cache -------------------------------------------------------
POSTGRES_PASSWORD=trader_dev
DB_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql://trader:trader_dev@localhost:5433/trader

# --- szyfrowanie sekretow w bazie --------------------------------------
# 32 bajty base64. Klucze API gield i sekrety TOTP sa szyfrowane AES-GCM tym kluczem.
# Generacja: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

# --- dostawca analizy wiadomosci ----------------------------------------
# Ustaw JEDEN z kluczy. Gdy sa oba, wygrywa Anthropic (dostawca docelowy).
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5
TRIAGE_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
ANALYSIS_MODEL_GEMINI=gemini-3.5-flash
TRIAGE_MODEL_GEMINI=gemini-3.5-flash-lite
# Minimalny odstep miedzy zapytaniami do Gemini. Klucz z darmowego progu ma
# limit zapytan na minute; 4 s miesci sie w nim z zapasem. Na kluczu platnym
# mozna zjechac do 0.
GEMINI_MIN_INTERVAL_S=4.0

# --- limity dobowe -------------------------------------------------------
# DWIE BRAMKI, NIE JEDNA - mierza rozne wielkosci i zadna nie zastepuje drugiej.
#
# Kwotowa nie zadzialala ani razu: 11.09.2026 potok stanal calkowicie przy
# $0,114 z $5, bo zatrzymal go DARMOWY prog Gemini liczony w ZAPYTANIACH.
# Bramka mierzaca inna wielkosc niz dostawca nie zatrzyma niczego przed nim.
LLM_DAILY_USD=5.0
# 1500 lezy miedzy zdrowa doba (503-516 wywolan) a doba z petla deduplikacji
# (4404). Lapie ucieczke, nie dotyka pracy.
LLM_DAILY_CALLS=1500

# NA PRODUKCJI TE CZTERY MODELE I OBA LIMITY USTAWIA CHART, nie ten plik:
# `charts/trader/values.yaml` -> `llm:`, wstrzykiwane przez `trader.llmEnv`
# do API i do wszystkich workerow naraz. Ten plik dotyczy wylacznie uruchomienia
# lokalnego.

# --- gieldy (uzupelniane przez UI, nie tutaj -- to tylko fallback dev) ---
BYBIT_DEMO_KEY=
BYBIT_DEMO_SECRET=
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
